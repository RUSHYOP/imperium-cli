{
  "name": "@rushy/imperium-cli",
  "version": "0.6.1",
  "description": "A package manager for agent context — install skills, reference packs, and presets for any AI agent ecosystem.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "imperium": "dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RUSHYOP/imperium-cli.git"
  },
  "homepage": "https://github.com/RUSHYOP/imperium-cli#readme",
  "bugs": {
    "url": "https://github.com/RUSHYOP/imperium-cli/issues"
  },
  "scripts": {
    "build": "tsup",
    "build:registry": "npx tsx scripts/build-registry.ts",
    "dev": "tsup --watch",
    "start": "node dist/bin.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:registry && npm run build",
    "postinstall": "node dist/postinstall.js"
  },
  "keywords": [
    "cli",
    "agent",
    "skills",
    "context",
    "claude",
    "copilot",
    "windsurf",
    "cursor",
    "ai",
    "package-manager"
  ],
  "author": "rushy",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "8.3.2",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "fastest-levenshtein": "1.0.16",
    "glob": "13.0.6",
    "gray-matter": "4.0.3",
    "ora": "9.3.0",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "25.5.0",
    "eslint": "^10.1.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
