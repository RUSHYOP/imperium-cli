  "gradient": {
    "_note": "Two families: primary (blue) and gray. First entry in each is a conic fade-to-transparent; the rest are linear at the listed angle.",
    "primary": [
      { "name": "600→500 conic",   "css": "conic-gradient(from 90deg, #0073E6 0%, rgba(0,115,230,0) 100%)" },
      { "name": "600→500 linear",  "css": "linear-gradient(90deg, #0068CF 0%, #0073E6 100%)" },
      { "name": "700→600 linear",  "css": "linear-gradient(45deg, #0058AF 0%, #0068CF 100%)" },
      { "name": "800→600 45deg",   "css": "linear-gradient(45deg, #00488F 0%, #0068CF 100%)" },
      { "name": "800→600 90deg",   "css": "linear-gradient(90deg, #00488F 0%, #0068CF 100%)" },
      { "name": "800→700 26.5deg", "css": "linear-gradient(26.5deg, #00488F 0%, #0058AF 100%)" },
      { "name": "900→600 45deg",   "css": "linear-gradient(45deg, #003870 0%, #0068CF 100%)" }
    ],
    "gray": [
      { "name": "600→500 conic",   "css": "conic-gradient(from 90deg, #475467 0%, rgba(71,84,103,0) 100%)" },
      { "name": "600→500 linear",  "css": "linear-gradient(90deg, #475467 0%, #667085 100%)" },
      { "name": "700→600 linear",  "css": "linear-gradient(45deg, #344054 0%, #475467 100%)" },
      { "name": "800→600 45deg",   "css": "linear-gradient(45deg, #1D2939 0%, #475467 100%)" },
      { "name": "800→600 90deg",   "css": "linear-gradient(90deg, #1D2939 0%, #475467 100%)" },
      { "name": "800→700 26.5deg", "css": "linear-gradient(26.5deg, #1D2939 0%, #344054 100%)" },
      { "name": "900→600 45deg",   "css": "linear-gradient(45deg, #101828 0%, #475467 100%)" }
    ]
  },

  "typography": {
    "fontFamily": "Inter, sans-serif",
    "fontWeights": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "fontSize": {
      "72": { "px": "72px", "rem": "4.5rem",   "role": "Display / Hero" },
      "60": { "px": "60px", "rem": "3.75rem",  "role": "Display" },
      "48": { "px": "48px", "rem": "3rem",     "role": "H1 / Page title" },
      "40": { "px": "40px", "rem": "2.5rem",   "role": "H2" },
      "36": { "px": "36px", "rem": "2.25rem",  "role": "H3" },
      "32": { "px": "32px", "rem": "2rem",     "role": "H4" },
      "28": { "px": "28px", "rem": "1.75rem",  "role": "H5" },
      "24": { "px": "24px", "rem": "1.5rem",   "role": "H6 / Large body" },
      "20": { "px": "20px", "rem": "1.25rem",  "role": "Subheading" },
      "18": { "px": "18px", "rem": "1.125rem", "role": "Large body" },
      "16": { "px": "16px", "rem": "1rem",     "role": "Body (default)" },
      "14": { "px": "14px", "rem": "0.875rem", "role": "Secondary body / labels" },
      "12": { "px": "12px", "rem": "0.75rem",  "role": "Helper / caption (mobile minimum)" },
      "10": { "px": "10px", "rem": "0.625rem", "role": "Fine print" },
      "8":  { "px": "8px",  "rem": "0.5rem",   "role": "Micro labels / badge text" }
    },
    "mobileMinimums": {
      "helperCaption": "12px",
      "body":          "13px",
      "title":         "16px"
    }
  },

  "spacing": {
    "_note": "4px soft grid. Token name = multiplier (1 = 1×4px). Prefer 8px multiples for layout; 4px for micro-adjustments.",
    "_base": "16px = 1rem",
    "scale": {
      "1":  { "px": "4px",   "rem": "0.25rem" },
      "2":  { "px": "8px",   "rem": "0.5rem"  },
      "3":  { "px": "12px",  "rem": "0.75rem" },
      "4":  { "px": "16px",  "rem": "1rem"    },
      "5":  { "px": "20px",  "rem": "1.25rem" },
      "6":  { "px": "24px",  "rem": "1.5rem"  },
      "8":  { "px": "32px",  "rem": "2rem"    },
      "10": { "px": "40px",  "rem": "2.5rem"  },
      "12": { "px": "48px",  "rem": "3rem"    },
      "16": { "px": "64px",  "rem": "4rem"    },
      "20": { "px": "80px",  "rem": "5rem"    },
      "24": { "px": "96px",  "rem": "6rem"    },
      "32": { "px": "128px", "rem": "8rem"    },
      "40": { "px": "160px", "rem": "10rem"   },
      "48": { "px": "192px", "rem": "12rem"   },
      "56": { "px": "224px", "rem": "14rem"   },
      "64": { "px": "256px", "rem": "16rem"   }
    },
    "containers": {
      "sm": { "px": "640px",  "rem": "40rem" },
      "md": { "px": "768px",  "rem": "48rem" },
      "lg": { "px": "1024px", "rem": "64rem" },
      "xl": { "px": "1280px", "rem": "80rem" }
    }
  },

  "shadow": {
    "_note": "All shadows use rgba(24,40,88, α) — the RXDS brand shadow color. Direction shown is Y-axis down (default). 8 directional variants exist (see shadows-and-blurs.md).",
    "shadowColor": "rgba(24, 40, 88, α)",
    "scale": {
      "xs": {
        "layers": 1,
        "css": "0 1px 2px 0 rgba(24,40,88,0.05)",
        "use": "Input focus rings, chips, small badges"
      },
      "sm": {
        "layers": 2,
        "css": "0 1px 2px 0 rgba(24,40,88,0.06), 0 1px 3px 0 rgba(24,40,88,0.10)",
        "use": "Buttons, list items, tooltips"
      },
      "md": {
        "layers": 2,
        "css": "0 2px 4px -2px rgba(24,40,88,0.06), 0 4px 8px -2px rgba(24,40,88,0.10)",
        "use": "Cards, interactive tiles"
      },
      "lg": {
        "layers": 2,
        "css": "0 4px 6px -2px rgba(24,40,88,0.03), 0 12px 16px -4px rgba(24,40,88,0.08)",
        "use": "Modals, drawer panels, popovers"
      },
      "xl": {
        "layers": 2,
        "css": "0 8px 8px -4px rgba(24,40,88,0.03), 0 20px 24px -4px rgba(24,40,88,0.08)",
        "use": "Full-screen overlays, floating panels"
      },
      "2xl": {
        "layers": 1,
        "css": "0 24px 48px -12px rgba(24,40,88,0.18)",
        "use": "Hero cards, spotlight panels"
      },
      "3xl": {
        "layers": 1,
        "css": "0 32px 64px -12px rgba(24,40,88,0.14)",
        "use": "Full-page overlays, splash elements"
      }
    },
    "directions": ["y-down", "y-up", "x-left", "x-right", "xy-left", "xy-up", "xy-right", "xy-bottom"]
  },

  "blur": {
    "_note": "Light variants: use over white/light backgrounds. Dark variants: use over dark/image backgrounds. Blur radius is identical per size.",
    "light": {
      "sm": { "radius": "8px",  "css": "backdrop-filter: blur(8px)",  "use": "Subtle frosted panel over light content" },
      "md": { "radius": "16px", "css": "backdrop-filter: blur(16px)", "use": "Sidepanel, popover over light page" },
      "lg": { "radius": "24px", "css": "backdrop-filter: blur(24px)", "use": "Modal overlay on light background" },
      "xl": { "radius": "40px", "css": "backdrop-filter: blur(40px)", "use": "Full-page glass overlay" }
    },
    "dark": {
      "sm": { "radius": "8px",  "css": "backdrop-filter: blur(8px)",  "use": "Frosted element over dark/image bg" },
      "md": { "radius": "16px", "css": "backdrop-filter: blur(16px)", "use": "Panels over hero images or dark sections" },
      "lg": { "radius": "24px", "css": "backdrop-filter: blur(24px)", "use": "Modal overlay on dark background" },
      "xl": { "radius": "40px", "css": "backdrop-filter: blur(40px)", "use": "Full-page glass overlay on dark bg" }
    }
  },

  "grid": {
    "columns": 12,
    "gutter": "24px",
    "viewports": {
      "web-centered": { "width": "1440px", "height": "768px", "nav": "80px both sides" },
      "web-left":     { "width": "1440px", "height": "768px", "nav": "60px left" },
      "tab-portrait": { "width": "768px",  "height": "1024px", "nav": "collapsed" },
      "mobile":       { "width": "360px",  "height": "880px",  "nav": "collapsed" }
    },
    "breakpoints": {
      "lg": "≥ 992px",
      "md": "768–991px",
      "sm": "< 768px"
    },
    "mobileReference": "360 × 800px (Android Large Variant)"
  },

  "iconography": {
    "styles": ["solid", "line", "2-shade-filled"],
    "mobileSizes": {
      "minimum": "16px (badges, dense contexts)",
      "base":    "24px (standard icon size)"
    },
    "categories": [
      "General", "Actions", "Charts", "Communication", "Layout",
      "Media & Internet", "Development", "Files", "Finance & eCommerce",
      "Security", "Web & Email", "Maps & Travel", "Weather", "Education", "Logistics"
    ]
  },

  "accessibility": {
    "contrast": {
      "bodyText":        "4.5:1 minimum (WCAG AA)",
      "largeText":       "3:1 minimum (≥ 24px normal, ≥ 18px bold)",
      "interactive":     "3:1 minimum (buttons, links, form controls)"
    },
    "touchTarget": "44 × 44px minimum on mobile",
    "mobileLineLength": "30–40 characters",
    "desktopLineLength": "45–80 characters",
    "zoom": "Content must be readable at 200% without horizontal scrolling",
    "principles": ["Perceivable", "Operable", "Understandable", "Robust"]
  },

  "colorUsageRules": {
    "backgrounds":   "Use shade 25–50 (very light). Never use 700–900 as backgrounds.",
    "interactive":   "Use shade 500 for primary interactive elements (buttons, links).",
    "pressed":       "Use shade 700 for pressed/active states.",
    "text":          "Use gray-900 or gray-800 for primary text; gray-700 for secondary.",
    "mobileRatio":   "60% White · 30% Primary · 10% Secondary",
    "semantic":      "Success/Warning/Error colors are semantic only — do not use for decoration.",
    "pageBackground":"Use information-25 (#F8F9FC) or gray-50 (#F9FAFB) for page backgrounds."
  }
}
