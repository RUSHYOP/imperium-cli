{
  "_doc": "Safe-to-use CSS classes in UIDL className and margin fields. Extracted from the runtime utility stylesheets (`packages/rui-components/src/assets/scss/3-basics/_spacers.scss`, `_helpers.scss`) plus the Bootstrap 4.6 grid subset. Use the real runtime class names directly, and if a handoff includes `c~mb-two-s`, strip `c~` and keep `mb-two-s`.",

  "spacing_margin": {
    "_doc": "Margin utilities — use on rows and wrapper divs for spacing between sections",
    "classes": [
      "m-0", "m-1", "m-2", "m-3", "m-4", "m-5",
      "mt-0", "mt-1", "mt-2", "mt-3", "mt-4", "mt-5",
      "mb-0", "mb-1", "mb-2", "mb-3", "mb-4", "mb-5",
      "ml-0", "ml-1", "ml-2", "ml-3", "ml-4",
      "mr-0", "mr-1", "mr-2", "mr-3", "mr-4",
      "mx-0", "mx-1", "mx-2", "mx-3", "mx-4", "mx-auto",
      "my-0", "my-1", "my-2", "my-3", "my-4"
    ],
    "scale": { "0": "0", "1": "5px", "2": "10px", "3": "15px", "4": "20px", "5": "3rem (48px)" },
    "useOn": "rows (via margin field), wrapper divs (via className)"
  },

  "spacing_padding": {
    "_doc": "Padding utilities — use on containers and columns for internal spacing",
    "classes": [
      "p-0", "p-1", "p-2", "p-3", "p-4",
      "pt-0", "pt-1", "pt-2", "pt-3", "pt-4",
      "pb-0", "pb-1", "pb-2", "pb-3", "pb-4",
      "pl-0", "pl-1", "pl-2", "pl-3", "pl-4",
      "pr-0", "pr-1", "pr-2", "pr-3", "pr-4",
      "px-0", "px-1", "px-2", "px-3", "px-4",
      "py-0", "py-1", "py-2", "py-3", "py-4"
    ],
    "scale": { "0": "0", "1": "5px", "2": "10px", "3": "15px", "4": "20px" },
    "useOn": "containers, columns — NOT on leaf Nb* components",
    "warning": "p-0 uses !important — never combine with custom padding in styles"
  },

  "spacing_token_margin": {
    "_doc": "Preferred runtime margin utilities from _spacers.scss — use these directly in UIDL and React wrappers",
    "classes": [
      "m-0", "m-half-s", "m-one-s", "m-one-half-s", "m-two-s", "m-two-half-s", "m-three-s", "m-four-s",
      "mt-0", "mt-quarter-s", "mt-half-s", "mt-one-s", "mt-one-half-s", "mt-two-s", "mt-two-half-s", "mt-three-s", "mt-four-s",
      "mb-0", "mb-half-s", "mb-one-s", "mb-one-half-s", "mb-two-s", "mb-two-half-s", "mb-three-s", "mb-four-s",
      "ml-0", "ml-half-s", "ml-one-s", "ml-one-half-s", "ml-two-s", "ml-two-half-s", "ml-three-s",
      "mr-0", "mr-half-s", "mr-one-s", "mr-one-half-s", "mr-two-s", "mr-two-half-s", "mr-three-s",
      "mx-0", "mx-half-s", "mx-one-s", "mx-one-half-s", "mx-two-s", "mx-two-half-s", "mx-three-s",
      "my-0", "my-half-s", "my-one-s", "my-one-half-s", "my-two-s", "my-two-half-s", "my-three-s"
    ],
    "useOn": "rows (via margin field), wrapper divs, and columns with direct leaf children"
  },

  "spacing_token_padding": {
    "_doc": "Preferred runtime padding utilities from _spacers.scss",
    "classes": [
      "p-0", "p-half-s", "p-one-s", "p-one-half-s", "p-two-s", "p-two-half-s", "p-three-s", "p-four-s",
      "pt-0", "pt-half-s", "pt-one-s", "pt-one-half-s", "pt-two-s", "pt-two-half-s", "pt-three-s",
      "pb-0", "pb-half-s", "pb-one-s", "pb-one-half-s", "pb-two-s", "pb-two-half-s", "pb-three-s",
      "pl-0", "pl-half-s", "pl-one-s", "pl-one-half-s", "pl-two-s", "pl-two-half-s", "pl-three-s",
      "pr-0", "pr-half-s", "pr-one-s", "pr-one-half-s", "pr-two-s", "pr-two-half-s", "pr-three-s",
      "px-0", "px-half-s", "px-one-s", "px-one-half-s", "px-two-s", "px-two-half-s", "px-three-s",
      "py-0", "py-half-s", "py-one-s", "py-one-half-s", "py-two-s", "py-two-half-s", "py-three-s"
    ],
    "useOn": "containers and columns for internal spacing"
  },

  "spacing_custom": {
    "_doc": "Custom spacing classes from global.scss — smaller granularity",
    "classes": [
      "mar-0", "mar-1", "mar-2", "mar-3", "mar-4",
      "pad-0", "pad-1", "pad-2", "pad-3", "pad-4"
    ],
    "scale": { "0": "0", "1": "2px", "2": "4px", "3": "6px", "4": "8px" }
  },

  "flex": {
    "_doc": "Flexbox utilities — use on columns to arrange multiple leaf components inline",
    "classes": [
      "d-flex", "d-inline-flex",
      "flex-row", "flex-column", "flex-wrap", "flex-nowrap",
      "align-items-start", "align-items-center", "align-items-end", "align-items-stretch",
      "justify-content-start", "justify-content-center", "justify-content-end",
      "justify-content-between", "justify-content-around",
      "align-self-start", "align-self-center", "align-self-end"
    ],
    "useOn": "columns (when placing multiple leaves side-by-side)"
  },

  "grid": {
    "_doc": "Bootstrap 12-column grid classes — used by UIDL layout.colLayout automatically",
    "classes": [
      "container", "container-fluid",
      "row", "no-gutters",
      "col", "col-auto",
      "col-1", "col-2", "col-3", "col-4", "col-5", "col-6",
      "col-7", "col-8", "col-9", "col-10", "col-11", "col-12",
      "col-sm-1", "col-sm-2", "col-sm-3", "col-sm-4", "col-sm-5", "col-sm-6",
      "col-sm-7", "col-sm-8", "col-sm-9", "col-sm-10", "col-sm-11", "col-sm-12",
      "col-md-1", "col-md-2", "col-md-3", "col-md-4", "col-md-5", "col-md-6",
      "col-md-7", "col-md-8", "col-md-9", "col-md-10", "col-md-11", "col-md-12",
      "col-lg-1", "col-lg-2", "col-lg-3", "col-lg-4", "col-lg-5", "col-lg-6",
      "col-lg-7", "col-lg-8", "col-lg-9", "col-lg-10", "col-lg-11", "col-lg-12",
      "col-xl-1", "col-xl-2", "col-xl-3", "col-xl-4", "col-xl-5", "col-xl-6",
      "col-xl-7", "col-xl-8", "col-xl-9", "col-xl-10", "col-xl-11", "col-xl-12"
    ],
    "note": "Grid classes are usually set via layout.colLayout — use className only for overrides"
  },

  "text": {
    "_doc": "Text alignment and font utilities",
    "classes": [
      "text-left", "text-center", "text-right",
      "font-bold", "font-11", "font-12", "font-14", "font-16"
    ],
    "useOn": "leaf components or wrappers when the component supports utility-based alignment"
  },

  "display": {
    "_doc": "Display utilities",
    "classes": [
      "d-none", "d-block", "d-inline", "d-inline-block",
      "d-sm-none", "d-sm-block", "d-md-none", "d-md-block",
      "d-lg-none", "d-lg-block", "d-xl-none", "d-xl-block"
    ]
  },

  "sizing": {
    "_doc": "Width/height utilities",
    "classes": [
      "w-25", "w-50", "w-75", "w-100",
      "h-25", "h-50", "h-75", "h-100",
      "wd-100"
    ],
    "note": "wd-100 is a runtime helper commonly used on leaf components like textbox with enableInheritWidth"
  },

  "position": {
    "_doc": "Position utilities from global.scss",
    "classes": [
      "position-relative", "position-absolute",
      "float-right"
    ]
  },

  "row_alignment": {
    "_doc": "Row vertical alignment classes from global.scss",
    "classes": [
      "aligntop", "alignmiddle", "alignbottom",
      "alignleft", "aligncenter", "alignright"
    ],
    "useOn": "rows — controls vertical alignment of columns"
  },

  "dividers": {
    "_doc": "Divider classes for visual borders between columns",
    "classes": [
      "dvright", "dvbottom", "dvleft", "dvtop"
    ],
    "useOn": "columns — adds a visual divider line on the specified side"
  },

  "visibility": {
    "_doc": "Smart visibility",
    "classes": [
      "smart-hide"
    ],
    "note": "Hides element when it has no content (:empty)"
  },

  "DO_NOT_USE": {
    "_doc": "App-specific classes from global.scss — these are NOT part of the design system and should never be used in UIDL",
    "classes": [
      "searchheadercontainer", "searchheader", "recordcontainer",
      "pageheader", "pagetitle", "tabfirst", "tabsecond",
      "customerdetails", "quickbookingadditionaldetailschktemplate",
      "standarddimensions", "consignmentdetailstable",
      "customcard-selected", "validation-msg",
      "pmsschedulerheaderrightside", "customNumeric",
      "BtSize", "leafIcon", "lnk_general",
      "w150px", "w100px", "w50px", "icon-delete",
      "loginroot", "loginload", "ui-container", "ui-container-full",
      "uibar", "cmbrole", "oucombo", "menuicon", "icononly",
      "red", "green", "color-aaa", "color-e99143", "color-51aef6", "color-c0c6d2"
    ],
    "reason": "These are legacy app-specific overrides, not reusable design system utilities"
  }
}
